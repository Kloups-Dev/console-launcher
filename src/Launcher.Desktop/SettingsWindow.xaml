<Window x:Class="Launcher.Desktop.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Réglages" Width="640" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="#111A28" Foreground="#EDF2FA" FontFamily="Segoe UI">
 <StackPanel Margin="30">
  <TextBlock Text="Préparer votre première partie" FontSize="25" FontWeight="SemiBold"/>
  <TextBlock Text="Sélectionnez Dolphin déjà installé sur votre PC." Margin="0,12,0,20" Foreground="{StaticResource Muted}"/>
  <TextBlock Text="Emplacement de Dolphin.exe"/>
  <DockPanel Margin="0,8,0,16"><Button Content="Parcourir…" Click="OnBrowse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="ExecutablePath" VerticalContentAlignment="Center" Padding="8"/></DockPanel>
  <TextBlock Text="Cette version utilise vos réglages et sauvegardes Dolphin existants. Le démarrage du jeu est direct et en plein écran. La configuration automatique des manettes en jeu n'est pas encore disponible." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
  <TextBlock x:Name="ErrorLabel" Foreground="#FFC49E" Margin="0,12,0,0" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Annuler" IsCancel="True" Margin="0,0,10,0"/><Button Content="Enregistrer" IsDefault="True" Click="OnSave"/></StackPanel>
 </StackPanel>
</Window>
